{
  "name": "codespark-agent",
  "displayName": "CodeSpark",
  "description": "A coding agent where you still code",
  "version": "0.28.0",
  "publisher": "codespark",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/christianalfoni/codespark"
  },
  "keywords": [
    "ai",
    "inline",
    "agent",
    "code generation",
    "copilot",
    "anthropic",
    "openai"
  ],
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeSpark",
          "title": "CodeSpark",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codeSpark": [
        {
          "id": "codeSpark.intents",
          "name": "Intent Comments",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "codeSpark.toggleIntentComment",
        "title": "CodeSpark: Toggle intent comment (MODIFY → ADD → REMOVE → off)"
      }
    ],
    "keybindings": [
      {
        "command": "codeSpark.toggleIntentComment",
        "mac": "cmd+shift+i",
        "win": "ctrl+shift+i",
        "linux": "ctrl+shift+i",
        "when": "editorTextFocus"
      }
    ],
    "colors": []
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "compile": "tsc -p ./ --noEmit",
    "lint": "eslint src --ext ts",
    "package": "npx @vscode/vsce package",
    "publish": "npx @vscode/vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.91.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.4"
  },
  "dependencies": {}
}
